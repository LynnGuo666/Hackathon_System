# 管理端认证 Token
ADMIN_TOKEN=secret

# 数据库文件路径
DATABASE_PATH=./hackathon.sqlite

# 前端静态文件目录（留空则不托管前端）
STATIC_DIR=

# CORS 允许的来源（逗号分隔多个）
CORS_ORIGIN=http://localhost:3000

# AES 加密凭据的主密钥文件路径（首次启动生成）
SECRET_KEY_FILE=.secret_key

# 是否启动后台任务 worker（测试时可关闭）
ENABLE_TASK_WORKER=true

# worker 轮询间隔（秒）
TASK_WORKER_POLL_INTERVAL=5

# worker 单次领取批量
TASK_WORKER_BATCH_SIZE=10
